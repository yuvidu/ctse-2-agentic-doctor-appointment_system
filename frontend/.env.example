# Production / cross-origin: set API origin without trailing slash.
# Leave empty when the UI is served from the same host and port as FastAPI
# (e.g. after `npm run build`, uvicorn serves `frontend/dist` and `/api/*` on the same origin).
VITE_API_BASE_URL=

# Optional: override Vite dev proxy target (default http://127.0.0.1:8010).
# VITE_DEV_API_PROXY=http://127.0.0.1:8010
